# ===== Supabase (production data store) =====
# צור פרויקט חינמי ב-https://supabase.com, ואז העתק מ-Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Green API (התראת WhatsApp אליך) =====
# https://green-api.com — חבר את הוואטסאפ שלך ב-QR והעתק את הפרטים
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# המספר שאליו יישלחו התראות הלידים (הנייד שלך), בפורמט בינלאומי ללא +, למשל 9725XXXXXXXX
LEAD_NOTIFY_WHATSAPP=
# אסימון אבטחה ל-webhook של הסרה (STOP). הגדר ב-Green API webhookUrl: /api/webhook/green?token=<זה>
GREEN_WEBHOOK_TOKEN=

# ===== Google Sheet (גיליון לידים) =====
# הדרך הפשוטה: צור Google Sheet, פתח Extensions > Apps Script, הדבק את scripts/google-apps-script.gs,
# פרוס כ-Web App (Anyone), והעתק לכאן את כתובת ה-/exec. אופציונלי — אפשר להתחיל בלי.
GOOGLE_SHEETS_WEBHOOK=

# ===== OTP / Phone Verification =====
# מחרוזת אקראית לחתימת קודי OTP (32+ תווים). צור עם: openssl rand -hex 32
# אם לא מוגדר — משתמש בברירת מחדל (פיתוח בלבד!)
OTP_SECRET=

# ===== פרטי המתווך (חובה חוקית — חוק המתווכים + אות אמון) =====
# מוצגים בדף ובשכבת האמון מעל שדה הטלפון
NEXT_PUBLIC_AGENT_NAME=
NEXT_PUBLIC_AGENT_LICENSE=
NEXT_PUBLIC_AGENT_PHOTO=
NEXT_PUBLIC_AGENT_TESTIMONIAL=
# הטלפון שיוצג על כפתור WhatsApp הצף (פורמט: 05XXXXXXXX). אם ריק — הכפתור לא יוצג.
NEXT_PUBLIC_AGENT_PHONE=

# ===== Analytics & Retargeting =====
# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX). ריק = ללא tracking.
NEXT_PUBLIC_GA4_ID=
# Facebook Pixel ID. ריק = ללא pixel.
NEXT_PUBLIC_FB_PIXEL_ID=

# ===== כללי =====
# מקור הנתונים בזמן פיתוח: local (קובץ JSON) או supabase
DATA_SOURCE=local
